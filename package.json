{
  "name": "fm-starter-ai",
  "description": "AI-assisted React and TypeScript starter for FileMaker Web Viewer widgets",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Dr. Adam G. Augustin",
    "email": "info@agametis.de",
    "url": "https://www.agametis.de"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/agametis/fm-starter-ai.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node ./scripts/verify-build-encoding.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "upload": "node ./fm/fmUpload.js",
    "deploy-to-fm": "npm-run-all build upload"
  },
  "dependencies": {
    "fm-gofer": "^1.10.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "baseline-browser-mapping": "^2.8.32",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "npm-run-all": "^4.1.5",
    "open": "^10.2.0",
    "terser": "^5.49.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^8.1.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=24"
  }
}
